{
  "name": "@srobroek/opencode-plugins",
  "private": true,
  "type": "module",
  "workspaces": ["plugins/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --config-path biome.json --max-diagnostics=1000",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "marketplaces": "bun scripts/build-marketplaces.ts",
    "marketplaces:check": "bun scripts/build-marketplaces.ts --check",
    "plugin-table": "bun scripts/build-plugin-table.ts",
    "plugin-table:check": "bun scripts/build-plugin-table.ts --check",
    "steering": "bun scripts/check-steering.ts",
    "pitfalls": "bun scripts/check-pitfalls.ts",
    "agent-roles": "bun scripts/check-agent-roles.ts",
    "descriptions": "bun scripts/check-descriptions.ts",
    "concerns": "bun scripts/check-concerns.ts",
    "test-executables": "bun scripts/check-test-executables.ts",
    "cad:sync": "bun scripts/sync-cad.ts",
    "cad:check": "bun scripts/sync-cad.ts --check",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:check && bun run marketplaces:check && bun run plugin-table:check && bun run steering && bun run pitfalls && bun run agent-roles && bun run descriptions && bun run concerns && bun run test-executables"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.9.3",
    "@opentui/solid": "0.9.3",
    "@types/bun": "1.4.4",
    "effect": "4.1.4",
    "solid-js": "1.9.19",
    "typescript": "7.0.2"
  }
}
