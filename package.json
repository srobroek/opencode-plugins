{
  "name": "@srobroek/opencode-plugins",
  "private": true,
  "type": "module",
  "workspaces": ["plugins/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --config-path biome.json --max-diagnostics=1000",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "marketplaces": "bun scripts/build-marketplaces.ts",
    "marketplaces:check": "bun scripts/build-marketplaces.ts --check",
    "plugin-table": "bun scripts/build-plugin-table.ts",
    "plugin-table:check": "bun scripts/build-plugin-table.ts --check",
    "steering": "bun scripts/check-steering.ts",
    "agent-roles": "bun scripts/check-agent-roles.ts",
    "descriptions": "bun scripts/check-descriptions.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:check && bun run marketplaces:check && bun run plugin-table:check && bun run steering && bun run agent-roles && bun run descriptions"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@opencode/client": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "2.2.6",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "1.4.4",
    "solid-js": "1.9.18",
    "typescript": "7.0.2"
  }
}
