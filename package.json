{
  "name": "@srobroek/opencode-plugins",
  "private": true,
  "type": "module",
  "workspaces": ["plugins/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --config-path biome.json --max-diagnostics=1000",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "marketplaces": "bun scripts/build-marketplaces.ts",
    "marketplaces:check": "bun scripts/build-marketplaces.ts --check",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:check && bun run marketplaces:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode/client": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "@opencode/theme": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/bun": "1.4.2",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  }
}
