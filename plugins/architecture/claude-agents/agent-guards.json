{
  "architect": [
    {
      "tools": [
        "Read"
      ],
      "rules": [
        {
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "resource": "*.env.example",
          "effect": "allow"
        }
      ]
    }
  ]
}
