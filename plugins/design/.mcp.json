{
  "mcpServers": {
    "accessibility-scanner": {
      "command": "npx",
      "args": ["-y", "accessibility-scanner-mcp@0.2.3"],
      "cwd": "${HOME}",
      "env": { "npm_config_registry": "https://registry.npmjs.org/" }
    },
    "wire-dsl": {
      "command": "npx",
      "args": ["-y", "@wire-dsl/mcp-server@0.1.3"],
      "cwd": "${HOME}",
      "env": { "npm_config_registry": "https://registry.npmjs.org/" }
    }
  }
}
